---
// Netlify serves this for any path that has no page. It wraps in the same shell
// as every other route — it used to carry its own hand-written copy, with its
// own widths and greys, and was the one page the design system could not reach.
import PageShell from '../layouts/PageShell.astro';
---

<PageShell
  title="Not found — Shizenryu Karate"
  description="That page could not be found on the Shizenryu Karate student hub."
  heading="NOT FOUND"
  subheading="Shizenryu Karate"
>
  <p class="body">That page isn't here. It may have moved, or the link may be mistyped.</p>
</PageShell>

<style>
  /* Body text, not a lede: the same weight of grey as every other paragraph a
     student reads, centred because the page is two lines and a link. */
  .body {
    font-size: .92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    text-align: center;
  }
</style>

---
// The belt list — replaces public/belts.html's #menu view. Each tile links to
// its own static route (/belts/<slug>) instead of a JS hash-driven view swap.
import PageShell from '../../layouts/PageShell.astro';
import { GRADES } from '../../data';
import '../../styles/belts.css';
---

<PageShell
  title="Shizenryu Belt Study Guides"
  description="Choose a belt to see everything on the syllabus for that grading, the key terms, and the mind behind the movement."
  heading="BELT STUDY GUIDES"
  subheading="What to learn · What it means"
  width="wide"
>
  <div class="card">
    <p class="intro">
      Choose your next belt. Each guide shows everything on the syllabus for that grading, the
      key terms, and the mind behind the movement.
    </p>
    <div class="belts" data-belt-slugs={JSON.stringify(GRADES.map((grade) => grade.slug))}>
      {
        GRADES.map((grade) => (
          <a class="belt-btn belt-colour" data-slug={grade.slug} href={`/belts/${grade.slug}`}>
            {grade.key}
          </a>
        ))
      }
    </div>
  </div>
</PageShell>

<script>
  // Old bookmarks like /belts.html#5th-kyu survive the Netlify redirect to /belts as
  // /belts#5th-kyu — fragments never reach the server, so only the browser can carry
  // them, and only client script can act on them. Upgrade a known belt fragment to its
  // real route; an unknown or absent fragment leaves the list rendering normally.
  const belts = document.querySelector('[data-belt-slugs]');
  const rawSlugs = belts instanceof HTMLElement ? belts.dataset.beltSlugs : undefined;
  const slug = location.hash.slice(1);

  if (typeof rawSlugs === 'string' && slug.length > 0) {
    const slugs = JSON.parse(rawSlugs);
    if (Array.isArray(slugs) && slugs.includes(slug)) {
      location.replace(`/belts/${slug}`);
    }
  }
</script>

<style>
  .intro {
    font-size: .85rem;
    color: #666;
    margin-bottom: 14px;
    text-align: center;
  }

  .belts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .belt-btn {
    display: block;
    border: none;
    border-radius: var(--radius-control);
    padding: 16px 12px;
    font-size: .95rem;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    letter-spacing: .03em;
    transition: transform .08s;
    text-decoration: none;
  }

  .belt-btn:active {
    transform: scale(.96);
  }
</style>

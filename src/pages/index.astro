---
// The home page — replaces public/index.html. Its masthead (crest image,
// three lines) and its footer text are the one part of every other route's
// shell this page doesn't want, so PageShell now offers optional `masthead`
// and `footer` slots — falling back to the h1/.sub pair and the "← Shizenryu
// home" link every inner page still uses — rather than this route
// duplicating the whole shell just to change two fragments of it.
//
// The maxim and streak chip are filled in client-side by
// public/assets/home.js — a plain external file, not an inlined component
// script (Astro inlines those, which the CSP a later slice adopts forbids;
// see that file's own header comment). This route's only job for them is to
// hand MAXIMS to the browser as a data attribute, the same contract shape
// legacy-hash.js already uses for its slugs, so home.js reads data instead
// of carrying its own copy of the content.
import PageShell from '../layouts/PageShell.astro';
import { MAXIMS } from '../data';
---

<PageShell
  title="Shizenryu Karate — Student Hub"
  description="Shizenryu Karate student hub: terminology quiz, kumite sequences, philosophy flashcards and study guides."
>
  <Fragment slot="masthead">
    <div class="crest">
      <img src="/assets/img/ki.png" width="200" height="236" alt="Shizenryu Ki logo" />
    </div>
    <h1>SHIZENRYU</h1>
    <div class="sub">The Natural Way of Karate</div>
    <div class="nat">Structure &gt; Discipline &gt; Measure / Accountability = Growth</div>
  </Fragment>

  <div class="maxim" data-maxims={JSON.stringify(MAXIMS)}>
    <span>Maxim of the day</span><em id="maxim"></em>
  </div>
  <div id="streakChip" class="streak-chip"></div>

  <h2>Train</h2>
  <div class="tiles">
    <a class="tile practice" href="/practice.html">
      <div class="t">Daily Practice</div>
      <div class="d">Tick off what you practised today — one thing is enough to keep your streak. Even a stretch.</div>
    </a>
    <a class="tile quiz" href="/quiz.html">
      <div class="t">Dojo Quiz</div>
      <div class="d">Terminology by belt level, plus the Kumite 1–12 sequences. Ten questions a round — know the words, own the art.</div>
    </a>
    <a class="tile cards" href="/flashcards.html">
      <div class="t">Philosophy Flashcards</div>
      <div class="d">The Maxims, Zen &amp; Karate, the root kata, Tui Shou, the 6 Human Needs, grades &amp; titles. Flip, recall, repeat.</div>
    </a>
    <a class="tile belts" href="/belts">
      <div class="t">Belt Study Guides</div>
      <div class="d">Your next grading, explained — every syllabus item, the key terms, and the mind behind the movement.</div>
    </a>
    <a class="tile kata" href="/kata">
      <div class="t">Kata Reference</div>
      <div class="d">Mara, Sanchin, Rokushu, Naifuanchin — what each kata is, what its name means, and where it lives in the syllabus.</div>
    </a>
  </div>

  <h2>Study</h2>
  <div class="tiles">
    <a class="doc" href="/docs/study-guides.pdf">
      <div><div class="n">Grade Study Guides</div><div class="s">One page per belt — techniques, terms and mind</div></div>
      <div class="pdf">PDF</div>
    </a>
    <a class="doc" href="/docs/philosophy-guide.pdf">
      <div><div class="n">Philosophy Study Guide</div><div class="s">The deeper elements, for advanced practitioners</div></div>
      <div class="pdf">PDF</div>
    </a>
    <a class="doc" href="/docs/belt-passport.pdf">
      <div><div class="n">Belt Passport</div><div class="s">Print at A5 — your record of the journey</div></div>
      <div class="pdf">PDF</div>
    </a>
  </div>

  <div class="seal">
    <img
      src="/assets/img/shizenryu-calligraphy.png"
      width="140"
      height="453"
      loading="lazy"
      decoding="async"
      alt="Shizenryu written in Japanese calligraphy"
    />
  </div>

  <Fragment slot="footer">
    Shizenryu Karate · Syllabus 2026<br />
    Ask your sensei anything — to ask is a moment; not to ask is a lifetime.
  </Fragment>

  <script slot="scripts" is:inline src="/assets/store.js" defer></script>
  <script slot="scripts" is:inline src="/assets/home.js" defer></script>
</PageShell>

<style>
  .crest {
    text-align: center;
    margin-bottom: 10px;
  }

  .crest img {
    width: 64px;
    height: auto;
  }

  .seal {
    text-align: center;
    margin-top: 34px;
  }

  .seal img {
    width: 46px;
    height: auto;
    opacity: .4;
  }

  h1 {
    text-align: center;
    font-size: 1.7rem;
    letter-spacing: .14em;
    color: var(--dark);
  }

  .sub {
    text-align: center;
    font-size: .75rem;
    letter-spacing: .25em;
    color: var(--red);
    text-transform: uppercase;
    margin: 6px 0 4px;
  }

  .nat {
    text-align: center;
    font-size: .85rem;
    color: var(--muted);
    font-style: italic;
    margin-bottom: 22px;
  }

  .maxim {
    background: var(--surface);
    border-left: 4px solid var(--red);
    padding: 14px 16px;
    font-style: italic;
    font-size: .92rem;
    color: #555;
    border-radius: 0 10px 10px 0;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
  }

  .maxim span {
    display: block;
    font-style: normal;
    font-size: .68rem;
    letter-spacing: .18em;
    color: var(--red);
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .streak-chip {
    text-align: center;
    font-size: .8rem;
    color: var(--gold);
    margin: -14px 0 20px;
    min-height: 1em;
  }

  h2 {
    font-size: .8rem;
    letter-spacing: .2em;
    color: var(--muted-light);
    text-transform: uppercase;
    margin: 22px 0 10px;
  }

  .tiles {
    display: grid;
    gap: 12px;
  }

  a.tile {
    display: block;
    text-decoration: none;
    border-radius: var(--radius-banner);
    padding: 18px;
    color: #fff;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .10);
    transition: transform .1s;
  }

  a.tile:active {
    transform: scale(.98);
  }

  .tile .t {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .tile .d {
    font-size: .82rem;
    opacity: .9;
    line-height: 1.4;
  }

  .practice {
    background: linear-gradient(120deg, var(--good), #00843D);
  }

  .quiz {
    background: linear-gradient(120deg, var(--red), #8B0A20);
  }

  .cards {
    background: linear-gradient(120deg, var(--dark), #3a3a3a);
  }

  .belts {
    background: linear-gradient(120deg, #00843D, var(--track-adult));
  }

  .kata {
    background: linear-gradient(120deg, var(--gold), #6B3F1D);
  }

  a.doc {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    background: var(--surface);
    border-radius: var(--radius-control);
    padding: 14px 16px;
    color: var(--ink);
    box-shadow: 0 1px 6px rgba(0, 0, 0, .07);
  }

  a.doc:active {
    background: #f4efe7;
  }

  .doc .n {
    font-weight: 600;
    font-size: .95rem;
  }

  .doc .s {
    font-size: .75rem;
    color: var(--muted-light);
    margin-top: 2px;
  }

  .doc .pdf {
    font-size: .65rem;
    font-weight: 700;
    color: #fff;
    background: var(--gold);
    padding: 4px 8px;
    border-radius: var(--radius-tag);
    letter-spacing: .08em;
  }

  /* PageShell's shared footer rule (app.css) sets a smaller font-size, a
     smaller margin-top and no line-height at all — this page's original
     footer set its own value for all four declarations below (color happens
     to already match the shared rule's --faint token exactly, but is
     restated here so this override is self-contained). Without it the two
     footer lines sit measurably closer together and higher up than in
     production.

     :global() is required, not stylistic: the <footer> tag itself is
     rendered by PageShell.astro, not by this file — only its slotted text
     content is authored here. A scoped `footer { ... }` rule compiles to
     `footer[data-astro-cid-<this-file>]`, which never matches an element
     PageShell rendered, so it silently did nothing (confirmed by measuring
     dist/index.html's computed footer styles before and after). Because
     this stylesheet is only bundled into the page that imports this
     component, :global(footer) still reaches only this route's footer, not
     belts/kata's.

     The gap between this page's original values and app.css's shared ones
     (.72rem vs .7rem, 28px vs 20px) is deliberate content this page is
     preserving, not a mistake to reconcile here — it's the same drift
     CLAUDE.md already documents for .app's max-width (480/520/560px across
     quiz/index/belts+kata), and Slice 9 owns normalising all of it in one
     pass. Until then this override keeps the home page pixel-faithful to
     its pre-migration original rather than silently drifting to whatever
     belts.html happened to use. */
  :global(footer) {
    font-size: .72rem;
    color: var(--faint);
    margin-top: 28px;
    line-height: 1.7;
  }

  /* Same shape as the footer override above, for the same reason: .app is
     rendered by PageShell.astro, not this file, so it cannot be reached by
     a scoped selector — only :global() lands on the real element. This
     page's original set `padding: 28px 16px 40px`; app.css's shared rule
     (transcribed from belts.html) sets `padding: 20px 16px 40px` — sides
     and bottom already agree, so only padding-top is restated here rather
     than repeating values the shared rule already has right (a second
     place to keep in sync otherwise). The 28px vs 20px gap is the same
     deliberate, not-yet-normalised drift as the footer's — Slice 9 owns
     collapsing it, not this route. */
  :global(.app) {
    padding-top: 28px;
  }
</style>

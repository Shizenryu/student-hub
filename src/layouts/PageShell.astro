---
// width applies a modifier class, not a style="" attribute or Astro's
// define:vars — both of those compile to an inline style="" attribute (Astro
// injects it on the component's parent element), which the CSP this site
// adopts later forbids: style-src covers attribute styles, and unlike a
// <style> element an inline attribute cannot be hashed. A narrow union keeps
// every width this site uses enumerable in app.css instead of scattering
// ad-hoc CSS across each consuming route.
import '../styles/tokens.css';
import '../styles/app.css';

// `masthead` and `footer` are overridable slots that fall back to today's
// markup, so belts/kata (and any future inner page) keep working with no slot
// supplied. `variant` is the shell's spacing scale, carried as an enumerated
// modifier class exactly as `width` already is — so a route adjusts the shell
// through the shell's own vocabulary instead of reaching into its elements
// with :global(). Today only the home page differs, and only until Slice 9
// normalises the spacing; see .app--home in app.css.
type Props = {
  title: string;
  description: string;
  heading?: string;
  subheading?: string;
  width?: 'default' | 'wide';
  variant?: 'inner' | 'home';
};

const { title, description, heading, subheading, width, variant } = Astro.props;

// heading/subheading are optional only because the masthead slot replaces them.
// (That is the whole reason for the `?` above.)
// Nothing in the type system ties those two facts together, so a route
// supplying neither typechecks and ships an empty <h1> — invisible in review,
// visible to a student. Astro.slots is the only place the slot is observable,
// so this is a build-time throw rather than a type: it runs while the page is
// generated, which fails `npm run build` and CI, not a browser.
if (!Astro.slots.has('masthead') && (!heading || !subheading)) {
  throw new Error(
    `PageShell rendering "${title}" supplied neither a masthead slot nor both heading and subheading — ` +
      'one of the two is required, or the page ships an empty header',
  );
}
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/assets/img/icon.png">
<link rel="apple-touch-icon" href="/assets/img/icon.png">
</head>
<body>
<div class:list={['app', { 'app--wide': width === 'wide', 'app--home': variant === 'home' }]}>
  <header>
    <slot name="masthead">
      <h1>{heading}</h1>
      <div class="sub">{subheading}</div>
    </slot>
  </header>

  <slot />

  <footer>
    <slot name="footer">
      <a href="/">← Shizenryu home</a><br>Structure &gt; Discipline &gt; Measure = Growth
    </slot>
  </footer>
</div>
<slot name="scripts" />
</body>
</html>

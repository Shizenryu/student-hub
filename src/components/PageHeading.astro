---
// The h1/.sub pair every inner page's header opens with.
//
// It exists because the header is no longer all-or-nothing. PageShell's slot used
// to be called `masthead` and REPLACED the header, which suited the home page (a
// crest and three lines instead of a heading) but not the three interactive pages
// coming next: quiz, flashcards and practice all want the ordinary heading pair
// AND a streak chip after it. Replacing the header to append one element meant
// copying this markup into each of them.
//
// So the slot now carries the header's content and this is the default's body,
// which any page can also compose with something of its own. Styling stays in
// app.css's `header h1` / `header .sub` rules — this owns the markup, not the look.
type Props = {
  heading: string;
  subheading: string;
};

const { heading, subheading } = Astro.props;
---
<h1>{heading}</h1>
<div class="sub">{subheading}</div>

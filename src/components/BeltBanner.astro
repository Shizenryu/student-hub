---
// A belt's banner: its name in its colour, with a small label saying what the
// page under it is. The belt guides and the kumite reference both open a belt
// this way, so it lives once, here. The colour is the .belt-colour rule in
// src/styles/base.css, which the shell loads on every page, so there is
// nothing to import here; belt-colours.test.ts pins that file to grades.json.
import type { Grade } from '../data';

type Props = {
  grade: Grade;
  label: string;
};

const { grade, label } = Astro.props;
---

<div class="banner belt-colour" data-slug={grade.slug}>
  <div><div class="t">{grade.banner}</div></div>
  <div class="s">{label}</div>
</div>

<style>
  .banner {
    border-radius: var(--radius-banner);
    padding: 16px 18px;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .banner .t {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: .04em;
  }

  .banner .s {
    font-size: .65rem;
    letter-spacing: .18em;
    opacity: .85;
  }
</style>
